# Credentials and local environment files
.env
.env.*
*.env
*credential*
*secret*

# Python and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Input data and generated outputs
data/raw/**
data/processed/**
data/generated/**
models/**
runs/**
logs/**

# Preserve the documented empty layout
!data/
!data/raw/
!data/processed/
!data/generated/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/generated/.gitkeep
!models/
!models/.gitkeep
!runs/
!runs/.gitkeep
!logs/
!logs/.gitkeep
